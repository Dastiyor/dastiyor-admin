# Postgres — the same database the Dastiyor mobile API uses.
# On Vercel these come from the Postgres integration; locally, `vercel env pull`.
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Signs admin login cookies. Required in production (the app refuses logins
# without it); 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs every admin out.
JWT_SECRET=""

# Vercel Blob, for avatar uploads.
BLOB_READ_WRITE_TOKEN=""
